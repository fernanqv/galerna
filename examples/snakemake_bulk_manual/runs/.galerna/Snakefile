import csv
import subprocess
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path


CASES_FILE = "cases.tsv"
TASKS_PER_JOB = 32
CPUS_PER_TASK = 16


cases = {}
with open(CASES_FILE, newline="") as f:
    reader = csv.DictReader(f, delimiter="\t")
    for row in reader:
        cases[row["case_id"]] = row


case_ids = sorted(cases)
bulk_groups = {
    f"{group_num:04d}": case_ids[start : start + TASKS_PER_JOB]
    for group_num, start in enumerate(range(0, len(case_ids), TASKS_PER_JOB))
}


def run_one_case(case):
    case_dir = Path(case["case_dir"])
    stdout_log = case_dir / "galerna.out"
    stderr_log = case_dir / "galerna.err"
    done_file = case_dir / ".galerna.done"

    with stdout_log.open("w") as stdout, stderr_log.open("w") as stderr:
        result = subprocess.run(
            case["command"],
            shell=True,
            cwd=case_dir,
            stdout=stdout,
            stderr=stderr,
            text=True,
        )

    if result.returncode != 0:
        raise subprocess.CalledProcessError(result.returncode, case["command"])

    done_file.touch()


rule all:
    input:
        expand("../bulk/bulk_{group_id}.done", group_id=bulk_groups.keys())


rule run_bulk:
    output:
        done="../bulk/bulk_{group_id}.done"
    log:
        "../bulk/bulk_{group_id}.log"
    threads: CPUS_PER_TASK
    params:
        case_ids=lambda wildcards: bulk_groups[wildcards.group_id]
    run:
        selected_cases = [cases[case_id] for case_id in params.case_ids]

        Path(log[0]).parent.mkdir(parents=True, exist_ok=True)
        with open(log[0], "w") as bulk_log:
            bulk_log.write(
                f"Running {len(selected_cases)} cases with {threads} workers\n"
            )
            bulk_log.flush()

            with ThreadPoolExecutor(max_workers=threads) as executor:
                futures = {
                    executor.submit(run_one_case, case): case["case_id"]
                    for case in selected_cases
                }

                for future in as_completed(futures):
                    case_id = futures[future]
                    future.result()
                    bulk_log.write(f"case {case_id} done\n")
                    bulk_log.flush()

        Path(output.done).touch()
